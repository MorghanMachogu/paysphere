# Copy to backend/.env and fill in. Never commit the real .env.
APP_ENV=development            # production enables HSTS
APP_DEBUG=false                # true shows internal error messages in API responses
APP_TIMEZONE=Africa/Nairobi

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=paysphere
DB_USER=paysphere
DB_PASS=MORGHAN

# Minutes a login session lasts
SESSION_LIFETIME=480

# Comma-separated web origins allowed to call the API (not needed when frontend and API share a domain)
CORS_ORIGIN=http://localhost:5173

# SMTP for payslips and notifications. Leave MAIL_HOST empty to write emails to backend/logs/email.log instead.
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=payroll@yourcompany.co.ke
MAIL_FROM_NAME=PaySphere
